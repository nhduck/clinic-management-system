server {
    listen ${CLIENT_INTERNAL_PORT};
    root /usr/share/nginx/html;
    absolute_redirect off;

    location = /health {
        default_type text/plain;
        return 200 'ok';
    }

    location ^~ /api/ {
        proxy_pass http://${API_HOST}:${API_PORT};
        proxy_set_header Host $host;
    }

    location = / {
        return 302 /login;
    }

    location ~ ^/(login|register)/?$ {
        try_files /pages/login.html =404;
    }

    location ~ ^/(appointments|my-appointments)/?$ {
        try_files /pages/appointments.html =404;
    }

    location ~ ^/(medical-records|prescriptions)(/[^/]+)?/?$ {
        try_files /pages/$1.html =404;
    }

    location ~ ^/(dashboard|patients|drugs|doctors|specialties|accounts)/?$ {
        try_files /pages/$1.html =404;
    }

    location / {
        try_files $uri =404;
    }
}