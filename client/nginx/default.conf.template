server {
    listen ${CLIENT_INTERNAL_PORT};
    root /usr/share/nginx/html;
    absolute_redirect off;

    location = /health {
        default_type text/plain;
        return 200 'ok';
    }

    location ^~ /api/ {
        proxy_pass http://${API_HOST}:${API_PORT};
        proxy_set_header Host $host;
    }

    location = / {
        return 302 /login;
    }

    location ~ ^/(login|register)/?$ {
        try_files /pages/dang-nhap.html =404;
    }

    location ~ ^/(appointments|my-appointments)/?$ {
        try_files /pages/lich-kham.html =404;
    }

    location ~ ^/medical-records(/[^/]+)?/?$ {
        try_files /pages/benh-an.html =404;
    }

    location ~ ^/prescriptions(/[^/]+)?/?$ {
        try_files /pages/don-thuoc.html =404;
    }

    location ~ ^/dashboard/?$ {
        try_files /pages/tong-quan.html =404;
    }

    location ~ ^/patients/?$ {
        try_files /pages/benh-nhan.html =404;
    }

    location ~ ^/drugs/?$ {
        try_files /pages/thuoc.html =404;
    }

    location ~ ^/doctors/?$ {
        try_files /pages/bac-si.html =404;
    }

    location ~ ^/specialties/?$ {
        try_files /pages/chuyen-khoa.html =404;
    }

    location ~ ^/accounts/?$ {
        try_files /pages/tai-khoan.html =404;
    }

    location / {
        try_files $uri =404;
    }
}